# Client-side Firebase configuration (public identifiers, NOT private service account keys)
# Leave blank to run FuelTill in local demonstration mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_FUNCTIONS_REGION=australia-southeast1
# Optional: configure Firebase App Check before enabling enforcement on Cloud Functions.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
